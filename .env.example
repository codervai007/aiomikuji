# Claude API key (server only — never exposed to the browser).
# Without it, the booth runs with prepared template fortunes.
ANTHROPIC_API_KEY=

# Optional: model to use (default: claude-haiku-5-5)
ANTHROPIC_MODEL=

# PIN for /staff (default 1234 — change it)
STAFF_PIN=

# Optional: URL for the QR code on the slip back and printout
NEXT_PUBLIC_GUIDE_URL=
